# CloudWise Frontend Environment Configuration
#
# Base URL of the Django backend. The Vite dev server proxies every /api/*
# request to it, so the React app never talks to a cross-origin API in local
# development (no CORS issues, and the JWT stays on the same origin).
#
# Keep the backend port in sync with GITHUB_REDIRECT_URI in backend/.env
# (the OAuth callback is http://localhost:8000/api/github/oauth/callback).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Copy this file to .env (or .env.local) to override any value:
#   cp .env.example .env
