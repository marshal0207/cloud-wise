SECRET_KEY=django-insecure-cloudwise-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# DATABASE_URL=postgres://user:password@localhost:5432/cloudwisedb

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/github/oauth/callback
FRONTEND_URL=http://localhost:5173

# AWS Pricing & Deployment (requires IAM user with AmazonEC2ReadOnlyAccess / AWSPriceListServiceFullAccess)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_PRICING_API_REGION=us-east-1

# AWS Deployment credentials (can be same as pricing, or a separate IAM role)
AWS_DEPLOY_ACCESS_KEY_ID=your-aws-deploy-access-key-id
AWS_DEPLOY_SECRET_ACCESS_KEY=your-aws-deploy-secret-access-key
AWS_DEPLOY_REGION=ap-south-1
AWS_EC2_KEY_NAME=your-ec2-keypair-name

# GCP (requires Cloud Billing Catalog API enabled + API key)
GCP_BILLING_API_KEY=your-gcp-billing-api-key

# Currency
USD_TO_INR_RATE=83

# ---------------------------------------------------------------
# Vercel deployment credentials
# Get your token from: https://vercel.com/account/tokens
# VERCEL_TEAM_ID is optional — only needed for team-owned projects
# Without VERCEL_TOKEN, deployment returns BLOCKED status.
# ---------------------------------------------------------------
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ---------------------------------------------------------------
# Render deployment credentials
# Get your API key from: https://dashboard.render.com/u/settings
# Get your Owner ID from: https://dashboard.render.com/u/settings ("Owner ID" field)
# Without RENDER_API_KEY and RENDER_OWNER_ID, deployment returns BLOCKED status.
# ---------------------------------------------------------------
RENDER_API_KEY=
RENDER_OWNER_ID=

# Azure (no server-side keys required; Azure Retail Prices API is public)
# AZURE_SUBSCRIPTION_ID=your-azure-subscription-id  # only if using ARM APIs in future
