SECRET_KEY=django-insecure-cloudwise-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# DATABASE_URL=postgres://user:password@localhost:5432/cloudwisedb
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/github/oauth/callback
FRONTEND_URL=http://localhost:5173
AWS_PRICING_API_REGION=us-east-1
USD_TO_INR_RATE=83

# ---------------------------------------------------------------
# Vercel deployment credentials
# Get your token from: https://vercel.com/account/tokens
# VERCEL_TEAM_ID is optional — only needed for team-owned projects
# Without VERCEL_TOKEN, deployment returns BLOCKED status.
# ---------------------------------------------------------------
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ---------------------------------------------------------------
# Render deployment credentials
# Get your API key from: https://dashboard.render.com/u/settings
# Get your Owner ID from: https://dashboard.render.com/u/settings ("Owner ID" field)
# Without RENDER_API_KEY and RENDER_OWNER_ID, deployment returns BLOCKED status.
# ---------------------------------------------------------------
RENDER_API_KEY=
RENDER_OWNER_ID=
