SECRET_KEY=django-insecure-cloudwise-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

CORS_ALLOW_ALL_ORIGINS=false

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/github/oauth/callback
FRONTEND_URL=http://localhost:5173

GITHUB_OAUTH_SCOPES=repo workflow

GITHUB_OAUTH_STATE_MAX_AGE=600

GITHUB_TOKEN_ENCRYPTION_KEY=
AWS_PRICING_API_REGION=us-east-1
USD_TO_INR_RATE=83


AWS_DEPLOYER_ACCESS_KEY_ID=
AWS_DEPLOYER_SECRET_ACCESS_KEY=
AWS_DEPLOYER_REGION=us-east-1
AWS_ROLE_SESSION_NAME=cloudwise-deploy
AWS_ROLE_DURATION_SECONDS=3600

AWS_TRUSTED_ACCOUNT_ID=

AWS_DEFAULT_REGION=ap-south-1
AWS_EC2_INSTANCE_TYPE=t3.micro

AWS_EC2_AMI_ID=
AWS_EC2_AMI_SSM_PARAMETER=/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64

AWS_EC2_KEY_NAME=

AWS_EC2_INSTANCE_PROFILE=
AWS_EC2_ROOT_VOLUME_GB=20
AWS_EC2_WAIT_FOR_RUNNING=true
AWS_EC2_WAIT_TIMEOUT_SECONDS=300

AWS_SECURITY_GROUP_NAME=cloudwise-sg
AWS_SECURITY_GROUP_PORTS=80,443,22
AWS_SECURITY_GROUP_HTTP_CIDR=0.0.0.0/0
AWS_SECURITY_GROUP_SSH_CIDR=0.0.0.0/0

AWS_INSTALL_DOCKER=true

AWS_DEPLOY_ROOT=/opt/cloudwise/projects
AWS_SSM_POLL_SECONDS=3
AWS_SSM_TIMEOUT_SECONDS=600
AWS_HEALTH_CHECK_RETRIES=30
AWS_HEALTH_CHECK_INTERVAL_SECONDS=2
AWS_HEALTH_CHECK_TIMEOUT_SECONDS=10

# Deployment pipeline threading.
# Leave unset/empty in production: the pipeline runs on a background thread
# so POST /api/deploy returns immediately with 201 + a QUEUED record.
# Set to 1 only when you want the deploy request to block until the pipeline
# finishes (used by the test suite).
DEPLOYMENT_RUN_INLINE=

