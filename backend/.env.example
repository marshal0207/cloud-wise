# Database
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/github/oauth/callback

# Frontend
FRONTEND_URL=http://localhost:5173

# AWS pricing
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_PRICING_API_REGION=us-east-1

# Currency conversion
USD_TO_INR_RATE=83

# AWS deployment
AWS_DEPLOY_ACCESS_KEY_ID=your-aws-deploy-access-key-id
AWS_DEPLOY_SECRET_ACCESS_KEY=your-aws-deploy-secret-access-key
AWS_DEPLOY_REGION=ap-south-1
AWS_EC2_KEY_NAME=your-ec2-keypair-name

# AWS deployer
AWS_DEPLOYER_ACCESS_KEY_ID=your-aws-deployer-access-key-id
AWS_DEPLOYER_SECRET_ACCESS_KEY=your-aws-deployer-secret-access-key

# GCP billing
GCP_BILLING_API_KEY=your-gcp-billing-api-key

# MongoDB Atlas
MONGODB_ATLAS_PUBLIC_KEY=your-mongodb-atlas-public-key
MONGODB_ATLAS_PRIVATE_KEY=your-mongodb-atlas-private-key
MONGODB_ATLAS_PROJECT_ID=your-mongodb-atlas-project-id
