SECRET_KEY=django-insecure-cloudwise-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# DATABASE_URL=postgres://user:password@localhost:5432/cloudwisedb

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/github/oauth/callback
FRONTEND_URL=http://localhost:5173

# AWS Pricing & Deployment (requires IAM user with AmazonEC2ReadOnlyAccess / AWSPriceListServiceFullAccess)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

CORS_ALLOW_ALL_ORIGINS=false

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/github/oauth/callback
FRONTEND_URL=http://localhost:5173

GITHUB_OAUTH_SCOPES=repo workflow

GITHUB_OAUTH_STATE_MAX_AGE=600

GITHUB_TOKEN_ENCRYPTION_KEY=
AWS_PRICING_API_REGION=us-east-1

# AWS Deployment credentials (can be same as pricing, or a separate IAM role)
AWS_DEPLOY_ACCESS_KEY_ID=your-aws-deploy-access-key-id
AWS_DEPLOY_SECRET_ACCESS_KEY=your-aws-deploy-secret-access-key
AWS_DEPLOY_REGION=ap-south-1
AWS_EC2_KEY_NAME=your-ec2-keypair-name

# GCP (requires Cloud Billing Catalog API enabled + API key)
GCP_BILLING_API_KEY=your-gcp-billing-api-key

# Currency
USD_TO_INR_RATE=83


# ---------------------------------------------------------------
# Render deployment credentials
# Get your API key from: https://dashboard.render.com/u/settings
# Get your Owner ID from: https://dashboard.render.com/u/settings ("Owner ID" field)
# Without RENDER_API_KEY and RENDER_OWNER_ID, deployment returns BLOCKED status.
# ---------------------------------------------------------------
RENDER_API_KEY=
RENDER_OWNER_ID=

# Azure (no server-side keys required; Azure Retail Prices API is public)
# AZURE_SUBSCRIPTION_ID=your-azure-subscription-id  # only if using ARM APIs in future
AWS_DEPLOYER_ACCESS_KEY_ID=
AWS_DEPLOYER_SECRET_ACCESS_KEY=
AWS_DEPLOYER_REGION=us-east-1
AWS_ROLE_SESSION_NAME=cloudwise-deploy
AWS_ROLE_DURATION_SECONDS=3600

AWS_TRUSTED_ACCOUNT_ID=

AWS_DEFAULT_REGION=ap-south-1
AWS_EC2_INSTANCE_TYPE=t3.micro

AWS_EC2_AMI_ID=
AWS_EC2_AMI_SSM_PARAMETER=/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64

AWS_EC2_INSTANCE_PROFILE=
AWS_EC2_ROOT_VOLUME_GB=30
AWS_EC2_WAIT_FOR_RUNNING=true
AWS_EC2_WAIT_TIMEOUT_SECONDS=300

AWS_SECURITY_GROUP_NAME=cloudwise-sg
AWS_SECURITY_GROUP_PORTS=80,443,22
AWS_SECURITY_GROUP_HTTP_CIDR=0.0.0.0/0
AWS_SECURITY_GROUP_SSH_CIDR=0.0.0.0/0

AWS_INSTALL_DOCKER=true

AWS_DEPLOY_ROOT=/opt/cloudwise/projects
AWS_SSM_POLL_SECONDS=3
AWS_SSM_TIMEOUT_SECONDS=600
AWS_HEALTH_CHECK_RETRIES=30
AWS_HEALTH_CHECK_INTERVAL_SECONDS=2
AWS_HEALTH_CHECK_TIMEOUT_SECONDS=10

MONGODB_ATLAS_PUBLIC_KEY=
MONGODB_ATLAS_PRIVATE_KEY=
MONGODB_ATLAS_PROJECT_ID=
