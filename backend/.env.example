SECRET_KEY=django-insecure-cloudwise-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# DATABASE_URL=postgres://user:password@localhost:5432/cloudwisedb
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/github/oauth/callback
FRONTEND_URL=http://localhost:5173
AWS_PRICING_API_REGION=us-east-1
USD_TO_INR_RATE=83

# ---------------------------------------------------------------
# Vercel deployment credentials
# Get your token from: https://vercel.com/account/tokens
# VERCEL_TEAM_ID is optional — only needed for team-owned projects
# Without VERCEL_TOKEN, deployment returns BLOCKED status.
# ---------------------------------------------------------------
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ---------------------------------------------------------------
# Render deployment credentials
# Get your API key from: https://dashboard.render.com/settings
# Get your Owner ID from: https://dashboard.render.com/settings ("Owner ID" field)
# Without RENDER_API_KEY and RENDER_OWNER_ID, deployment returns BLOCKED status.
# ---------------------------------------------------------------
RENDER_API_KEY=
RENDER_OWNER_ID=

# ---------------------------------------------------------------
# AWS account connection + EC2 provisioning (Part 3)
#
# Users NEVER provide permanent AWS access keys. Each user connects by
# creating an IAM role in their own AWS account (least-privilege, no
# AdministratorAccess) and CloudWise assumes it via sts:AssumeRole with a
# per-user External ID, receiving short-lived temporary credentials.
#
# AWS_DEPLOYER_* = CloudWise platform credentials used ONLY to call
# sts:AssumeRole. Server-side only — never exposed to the frontend.
# Falls back to the boto3 default credential chain when unset.
# ---------------------------------------------------------------
AWS_DEPLOYER_ACCESS_KEY_ID=
AWS_DEPLOYER_SECRET_ACCESS_KEY=
AWS_DEPLOYER_REGION=us-east-1
AWS_ROLE_SESSION_NAME=cloudwise-deploy
AWS_ROLE_DURATION_SECONDS=3600
# Optional: your CloudWise AWS account id shown in the user's trust policy.
# Empty = auto-detected from the deployer credentials via sts:GetCallerIdentity.
AWS_TRUSTED_ACCOUNT_ID=

# ---------------------------------------------------------------
# EC2 provisioning configuration (configurable — not hardcoded)
# ---------------------------------------------------------------
AWS_DEFAULT_REGION=ap-south-1
AWS_EC2_INSTANCE_TYPE=t3.micro
# Empty = resolve latest Amazon Linux 2023 AMI via the public SSM parameter
AWS_EC2_AMI_ID=
AWS_EC2_AMI_SSM_PARAMETER=/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64
# Optional SSH key pair name (empty = no key; SSH/SSM access is configurable)
AWS_EC2_KEY_NAME=
# Optional EC2 instance profile name (e.g. for SSM Session Manager access)
AWS_EC2_INSTANCE_PROFILE=
AWS_EC2_ROOT_VOLUME_GB=20
AWS_EC2_WAIT_FOR_RUNNING=true
AWS_EC2_WAIT_TIMEOUT_SECONDS=300

# Security group — only these ports are opened publicly (80/443/22).
# Application ports are intentionally NOT exposed.
AWS_SECURITY_GROUP_NAME=cloudwise-sg
AWS_SECURITY_GROUP_PORTS=80,443,22
AWS_SECURITY_GROUP_HTTP_CIDR=0.0.0.0/0
AWS_SECURITY_GROUP_SSH_CIDR=0.0.0.0/0

# Install Docker + Docker Compose on first boot via EC2 user data
AWS_INSTALL_DOCKER=true

# ---------------------------------------------------------------
# Container deployment via SSM (Part 4)
# Requires AWS_EC2_INSTANCE_PROFILE with AmazonSSMManagedInstanceCore
# so CloudWise can push files and run docker compose on the instance.
# ---------------------------------------------------------------
AWS_DEPLOY_ROOT=/opt/cloudwise/projects
AWS_SSM_POLL_SECONDS=3
AWS_SSM_TIMEOUT_SECONDS=600
AWS_HEALTH_CHECK_RETRIES=30
AWS_HEALTH_CHECK_INTERVAL_SECONDS=2
AWS_HEALTH_CHECK_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------
# CloudWise repository analysis limits (optional)
# Platform limits applied when scanning GitHub repositories.
# ---------------------------------------------------------------
# MAX_REPOSITORY_SIZE_MB=500
# MAX_FILES=10000
# MAX_SINGLE_FILE_MB=10
# MAX_ANALYSIS_TIME_MINUTES=5
